# English Speaking Voice Generator — server-side settings.
# Copy this file to .env.local and fill in at least ONE API key.
# These values stay on the server and are never sent to the browser.

# --- Option A (recommended): Google Gemini TTS ---------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY also works if you prefer that name.
# GOOGLE_API_KEY=
# Optional: a different Gemini TTS model, e.g. gemini-2.5-pro-preview-tts
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Option B: OpenAI TTS -------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: a different OpenAI TTS model that accepts voice instructions.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# If both keys are set, both engines appear in the app. This picks the default.
# TTS_PROVIDER=gemini

# Advanced: send requests through a proxy or compatible gateway.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# OPENAI_BASE_URL=https://api.openai.com/v1
